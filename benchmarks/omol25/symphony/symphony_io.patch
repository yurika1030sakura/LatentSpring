-        del min_dist
+        # BGFM: OMol25 has disconnected systems (e.g. far metal+ligand at the
+        # radial cutoff), so the visited->unvisited frontier can be empty. Guard
+        # the .min() to avoid a zero-size reduction crash; leave mask empty.
+        valid = dist[mask]
