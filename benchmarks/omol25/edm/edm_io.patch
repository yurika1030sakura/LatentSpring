diff --git a/qm9/dataset.py b/qm9/dataset.py
index cb0f59d..6a0783b 100644
--- a/qm9/dataset.py
+++ b/qm9/dataset.py
@@ -63,6 +63,25 @@ def retrieve_dataloaders(cfg):
                 shuffle=shuffle)
         del split_data
         charge_scale = None
+    elif 'omol25' in cfg.dataset:
+        # BGFM: OMol25 (bond-free, 83 elements). Reuses EDM's PreprocessQM9
+        # collate; only the dataset source is swapped. I/O only.
+        from qm9.omol25_data import OMol25EDMDataset
+        from configs.datasets_config import get_dataset_info
+        info = get_dataset_info(cfg.dataset, getattr(cfg, 'remove_h', False))
+        n_species = len(info['atom_decoder'])
+        preprocess = PreprocessQM9(load_charges=cfg.include_charges)
+        dataloaders = {}
+        # EDM uses split key 'valid'; our processed file is 'val_data_processed.pt'.
+        for key, fsplit in [('train', 'train'), ('valid', 'val'), ('test', 'test')]:
+            ds = OMol25EDMDataset(cfg.datadir, fsplit, n_species=n_species)
+            dataloaders[key] = DataLoader(
+                ds, batch_size=cfg.batch_size,
+                shuffle=(key == 'train'),
+                num_workers=cfg.num_workers,
+                collate_fn=preprocess.collate_fn,
+                drop_last=True)  # EDM's kl_prior .squeeze() breaks on size-1 batches
+        charge_scale = None
     else:
         raise ValueError(f'Unknown dataset {cfg.dataset}')
 
