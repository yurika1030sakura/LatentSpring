% ---------------------------------------------------------------------
% Appended by the 2026-08-03 REVIEWER-RESPONSE REVISION (novelty-attribution
% pass).  These are the prior-work citations for the LOG-VARIANCE DIVERGENCE,
% which is what our L_energy is: with \tilde p = e^{-E/kT} (unnormalised) and
% q = p_theta, Var[log p_theta + E/kT] = Var[log q - log \tilde p], i.e. the
% log-variance divergence between q and the Gibbs target.  The cancellation of
% the normalising constant is a KNOWN structural property of that divergence
% (it is why the estimator needs no partition function), NOT a contribution of
% this paper.  All four entries verified 2026-08-03 against arXiv / proceedings.
% ---------------------------------------------------------------------

% VERIFIED 2026-08-03: arxiv.org/abs/2010.10436 ; NeurIPS 33 (2020), paper hash
% 9c22c0b51b3202246463e986c7e205df.  This is the paper that NAMES the
% log-variance loss Var[log(p/q)] and shows its gradient equals the ELBO
% gradient with leave-one-out control variates ("VarGrad").
@inproceedings{vargrad,
  title        = {{VarGrad}: A Low-Variance Gradient Estimator for Variational Inference},
  author       = {Richter, Lorenz and Boustati, Ayman and N{\"u}sken, Nikolas and
                  Ruiz, Francisco J. R. and Akyildiz, {\"O}mer Deniz},
  booktitle    = {Advances in Neural Information Processing Systems (NeurIPS)},
  volume       = {33},
  year         = {2020},
  note         = {arXiv:2010.10436}
}

% VERIFIED 2026-08-03: arxiv.org/abs/2005.05409 ; Partial Differential Equations
% and Applications 2(4), 2021, doi 10.1007/s42985-021-00102-x.  Introduces the
% path-space divergence family (including the log-variance / second-moment
% divergences) and the off-policy freedom in the reference measure.
@article{nusken2021pathspace,
